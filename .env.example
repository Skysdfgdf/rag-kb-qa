# ============================================================
# RAG 知识库问答系统 —— 配置示例
# 复制为 .env 后按需修改
# ============================================================

# ---------- Embedding 模型 ----------
# 可选: fastembed(本地,默认) | openai(走 API) | offline(本地哈希,免下载,演示用)
EMBEDDING_PROVIDER=fastembed
# 本地模型（fastembed 支持，中文推荐 bge 系列，512 维，体积小）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若使用 openai embedding:
OPENAI_EMBED_MODEL=text-embedding-3-small
# offline 模式的向量维度
OFFLINE_EMBED_DIM=256

# ---------- 向量库 ----------
# Chroma 持久化目录 & 集合名
CHROMA_PATH=./data/chroma
COLLECTION_NAME=kb_default

# ---------- 文档切分 ----------
CHUNK_SIZE=480
CHUNK_OVERLAP=80

# ---------- 检索 ----------
TOP_K=6                 # 最终喂给大模型的上下文块数
VECTOR_TOP_K=20         # 向量召回候选数（再经 RRF 重排）
USE_RERANK=true         # 是否启用 BM25 + RRF 重排

# ---------- 大模型（OpenAI 兼容 API）----------
# llm_provider: openai(真实大模型) | mock(离线演示,无需 Key)
LLM_PROVIDER=openai
# 任何兼容 /v1/chat/completions 的服务都可：OpenAI / DeepSeek / 通义 / 智谱 / Ollama 等
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---------- OpenAI（仅当 EMBEDDING_PROVIDER=openai 时需要）----------
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 访问控制 / 角色权限（远端部署安全）----------
# 管理员口令（必填以启用鉴权）：全权限（上传 / 删除 / 列表 / 问答）
ADMIN_PASSWORD=
# 普通用户口令（可选）：只读身份，仅可列表 / 问答，不能上传或删除。留空则只有管理员能用
USER_PASSWORD=
# 单文件最大字节数（默认 10MB）。超出返回 413
MAX_UPLOAD_SIZE=10485760

# ---------- 线上同步目标（sync.py 使用）----------
# 本地库 -> 线上库的单向增量同步；填线上域名与链接里的 sharecode
REMOTE_BASE_URL=
REMOTE_SHARECODE=

# ---------- 限流（防刷大模型额度 / 防口令爆破）----------
# 滑动窗口计数，进程内实现。任何一项设为 0 表示不限制。
RATE_LIMIT_ENABLED=true
# 单个资料库每分钟 / 每小时提问次数（管理员不受此限）
RATE_LIMIT_QUERY_PER_MIN=20
RATE_LIMIT_QUERY_PER_HOUR=300
# 单个 IP 每分钟请求总数。注意：部署平台网关会让所有访问者共用出口 IP，
# 这一层是兜底，真正的配额靠上面按资料库计数
RATE_LIMIT_IP_PER_MIN=120
# 单个资料库每分钟上传次数
RATE_LIMIT_UPLOAD_PER_MIN=10
# 单个 IP 每分钟登录尝试次数（防止暴力猜管理员口令；部署平台网关轮换出口 IP，此项在线上不生效）
RATE_LIMIT_LOGIN_PER_MIN=10
# 全站每分钟登录尝试总数（不依赖 IP，防爆破的兜底；正常人一分钟远用不到 30 次）
RATE_LIMIT_LOGIN_GLOBAL_PER_MIN=30
# 单个 IP 每分钟资料库编号查询次数
RATE_LIMIT_CHECK_PER_MIN=30
